generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model generations {
  id         Int       @id @default(autoincrement())
  generation Int?
  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @default(now()) @db.DateTime(0)
}

model users {
  id                    Int       @id @default(autoincrement())
  googleId              String?   @unique(map: "user_googleId_key")
  email                 String?   @unique(map: "user_email_key")
  name                  String?
  profilePicture        String?
  student_id            Int?
  prefix                String?   @db.VarChar(255)
  f_name                String?   @db.VarChar(255)
  l_name                String?   @db.VarChar(255)
  gen                   Int?
  image_student_profile String?   @db.VarChar(255)
  role                  String?   @default("1") @db.VarChar(255)
  createdAt             DateTime? @default(now())
  updatedAt             DateTime? @default(now())
}
